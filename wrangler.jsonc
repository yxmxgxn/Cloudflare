{
  "name": "karin-archive",
  "compatibility_date": "2026-07-06",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 画面遷移(Sec-Fetch-Mode: navigate)のリクエストは、アセットが無いと
    // not_found_handling の404ページが返りWorkerが起動しない。APIと管理ページは
    // アセットを持たないため、この2つだけ先にWorkerへ渡す。
    // 全体を true にすると静的ページも毎回Worker経由になるので範囲を限定する。
    // /hello-kenshusei-blog と /hello-articles は ?m=(メンバー) のときにタイトルと canonical を書き換えるため(worker/index.js)
    "run_worker_first": ["/api/*", "/_feedback", "/_feedback/*", "/hello-kenshusei-blog", "/hello-articles"]
  },
  // Cron は使わない。以前ブログコメント保存で登録していたものを外すため空にしておく
  // (triggers を書かないだけだと、登録済みの Cron がそのまま残る)
  "triggers": { "crons": [] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karin-interview",
      "database_id": "830920cc-15cf-4522-b9cb-6a96fade5273"
    },
    {
      // #佳林の１日１ハロ のポスト本文検索(bigram索引のみ。本文は持たない)
      "binding": "HELLO_DB",
      "database_name": "karin-hello",
      "database_id": "9cbb8446-a16b-4051-ac67-5767774d0a19"
    }
  ]
}
