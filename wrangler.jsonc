{
  "name": "karin-archive",
  "compatibility_date": "2026-07-06",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karin-interview",
      "database_id": "830920cc-15cf-4522-b9cb-6a96fade5273"
    }
  ]
}
