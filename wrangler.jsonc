{
  "name": "karin-archive",
  "compatibility_date": "2026-07-06",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 画面遷移(Sec-Fetch-Mode: navigate)のリクエストは、アセットが無いと
    // not_found_handling の404ページが返りWorkerが起動しない。APIと管理ページは
    // アセットを持たないため、この2つだけ先にWorkerへ渡す。
    // 全体を true にすると静的ページも毎回Worker経由になるので範囲を限定する。
    "run_worker_first": ["/api/*", "/_feedback", "/_feedback/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karin-interview",
      "database_id": "830920cc-15cf-4522-b9cb-6a96fade5273"
    }
  ]
}
