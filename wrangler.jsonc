{
  "name": "karin-archive",
  "compatibility_date": "2026-07-06",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 画面遷移(Sec-Fetch-Mode: navigate)のリクエストは、アセットが無いと
    // not_found_handling の404ページが返りWorkerが起動しない。APIと管理ページは
    // アセットを持たないため、この2つだけ先にWorkerへ渡す。
    // 全体を true にすると静的ページも毎回Worker経由になるので範囲を限定する。
    "run_worker_first": ["/api/*", "/_feedback", "/_feedback/*"]
  },
  // 宮本佳林のブログに残した自分のコメントを拾う(worker/index.js の scheduled)。3時間おき
  "triggers": { "crons": ["0 */3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karin-interview",
      "database_id": "830920cc-15cf-4522-b9cb-6a96fade5273"
    },
    {
      // #佳林の１日１ハロ のポスト本文検索(bigram索引のみ。本文は持たない)
      "binding": "HELLO_DB",
      "database_name": "karin-hello",
      "database_id": "9cbb8446-a16b-4051-ac67-5767774d0a19"
    },
    {
      // 宮本佳林のブログに残した自分のコメント(Cron が書き込む)
      "binding": "COMMENT_DB",
      "database_name": "karin-blog-comment",
      "database_id": "9fe65bf5-bd1d-4aeb-87bf-2ccb8918d5b1"
    }
  ]
}
